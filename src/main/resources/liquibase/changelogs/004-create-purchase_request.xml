<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="1" author="IsIsabella">
        <createTable tableName="purchase_request">
            <column name="id" type="SERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR"/>
            <column name="amount" type="NUMERIC(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="status_id" type="INTEGER">
                <constraints nullable="false"
                             foreignKeyName="fk_purchase_request_status"
                             referencedTableName="ref_status"
                             referencedColumnNames="id"/>
            </column>
            <column name="created_by" type="INTEGER">
                <constraints nullable="false"
                             foreignKeyName="fk_purchase_request_created_by"
                             referencedTableName="users"
                             referencedColumnNames="id"/>
            </column>
            <column name="approved_by" type="INTEGER">
                <constraints foreignKeyName="fk_purchase_request_approved_by"
                             referencedTableName="users"
                             referencedColumnNames="id"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <createIndex indexName="idx_purchase_request_status"
                     tableName="purchase_request">
            <column name="status_id"/>
        </createIndex>
        <rollback>
            <dropTable tableName="purchase_request"/>
        </rollback>
    </changeSet>

    <changeSet id="2" author="IsIsabella">
        <tagDatabase tag="004-create-purchase_request"/>
    </changeSet>

</databaseChangeLog>